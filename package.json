{
  "name": "purus-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo of the Purus compiler (MoonBit) and its tooling",
  "license": "Apache-2.0",
  "author": "otoneko. (https://github.com/otnc)",
  "homepage": "https://purus.work",
  "repository": {
    "type": "git",
    "url": "https://github.com/puruslang/purus"
  },
  "bugs": {
    "url": "https://github.com/puruslang/purus/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/otnc"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "moon test --target js",
    "build:compiler": "moon build --target js --release",
    "build:packages": "pnpm --filter \"./packages/*\" --if-present run build",
    "build": "pnpm run build:compiler && pnpm run build:packages",
    "lint": "moon check",
    "lint:fix": "moon fmt",
    "format:check": "moon fmt --check",
    "format": "moon fmt",
    "typecheck": "moon check",
    "check": "pnpm run lint && pnpm run format:check && pnpm run build && pnpm run typecheck",
    "typecheck:ts": "pnpm --filter \"./packages/*\" --if-present run typecheck",
    "test:packages": "pnpm --workspace-concurrency=1 --filter \"./packages/*\" --if-present run test",
    "lint:ts": "eslint packages",
    "format:check:ts": "prettier --check packages .prettierrc.json eslint.config.mjs tsconfig.base.json",
    "format:ts": "prettier --write packages .prettierrc.json eslint.config.mjs tsconfig.base.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.72.0",
    "typescript": "^6.0.3"
  }
}
