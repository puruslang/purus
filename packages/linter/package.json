{
  "name": "@puruslang/linter",
  "version": "1.0.1",
  "description": "Linter for the Purus language",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.mts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "purus-lint": "dist/cli.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "linter",
    "purus",
    "static-analysis",
    "altjs",
    "lang",
    "language",
    "noshift"
  ],
  "author": "otoneko. (https://github.com/otnc)",
  "homepage": "https://purus.work",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puruslang/purus.git",
    "directory": "packages/linter"
  },
  "bugs": {
    "url": "https://github.com/puruslang/purus/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/otnc"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
